<Window x:Class="Cuckoo.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cuckoo.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Cuckoo" Icon="Assets/cuckoo.ico"
        Width="216" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        Topmost="{Binding MiniAlwaysOnTop}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BitmapImage x:Key="CuckooImage" UriSource="pack://application:,,,/Assets/cuckoo.ico" />

        <!-- macOS-style traffic light dot -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"
                                     Stroke="#30000000" StrokeThickness="0.8" />
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                       FontSize="8" FontWeight="Bold" Foreground="#99000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="14" Margin="10"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <!-- traffic lights -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource DotButton}" Background="#FF5F57" Content="×"
                        Click="CloseDot_Click" ToolTip="Exit Cuckoo" />
                <Button Style="{StaticResource DotButton}" Background="#FEBC2E" Content="-"
                        Click="MinimizeDot_Click" ToolTip="Hide to tray" />
                <Button Style="{StaticResource DotButton}" Background="#28C840" Content="⤢"
                        Click="ExpandDot_Click" ToolTip="Back to full view" />
            </StackPanel>

            <!-- game box art -->
            <Border CornerRadius="8" Margin="0,12,0,0" HorizontalAlignment="Center"
                    Background="#18808080" Padding="4">
                <Image Width="108" Height="144" Stretch="Uniform"
                       Source="{Binding CurrentCampaign.BoxArt, TargetNullValue={StaticResource CuckooImage}, FallbackValue={StaticResource CuckooImage}}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <!-- status -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusDotBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding MiniTitleText}" FontSize="17" FontWeight="SemiBold"
                           Margin="7,0,0,0" />
            </StackPanel>

            <!-- drop name -->
            <TextBlock Text="{Binding DropRewardsText}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="36" Opacity="0.75" Margin="0,3,0,0" />

            <!-- remaining time -->
            <TextBlock Text="{Binding DropRemainingText}" HorizontalAlignment="Center"
                       FontSize="11" Opacity="0.6" Margin="0,3,0,0"
                       Visibility="{Binding MiniShowRemaining, Converter={StaticResource BoolToVis}}" />

            <!-- progress bar -->
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding MiniBarVisible, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="14" Minimum="0" Maximum="1"
                             Value="{Binding MiniProgressValue, Mode=OneWay}" />
                <TextBlock Text="{Binding MiniPercentText}" FontSize="9" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding MiniShowPercent, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
