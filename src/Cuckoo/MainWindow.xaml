<Window x:Class="Cuckoo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:Cuckoo.ViewModels"
        xmlns:models="clr-namespace:Cuckoo.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Cuckoo" Height="860" Width="1100"
        MinHeight="640" MinWidth="900"
        Icon="Assets/cuckoo.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Elevated card panel: every UI topic sits on one of these -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#14808080" />
            <Setter Property="BorderBrush" Value="#30808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.25" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Search bar: magnifier + stretching textbox -->
        <ControlTemplate x:Key="SearchBar" TargetType="ContentControl">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ContentPresenter Grid.Column="1" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{Binding TrayToolTip}"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Restore" Click="TrayRestore_Click" />
                    <MenuItem Header="Toggle mini view" Click="TrayToggleMini_Click" />
                    <MenuItem Header="Reload" Command="{Binding ReloadCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- brand hint, sits in the unused space right of the tab strip -->
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,12,16,0" Panel.ZIndex="1" IsHitTestVisible="False"
                   Foreground="Gray" FontSize="11"
                   Text="{Binding BrandText}" />

        <TabControl Margin="4">
            <!-- ============================ MAIN TAB ============================ -->
            <TabItem Header="Main">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1.6*" />
                    </Grid.RowDefinitions>

                    <!-- Login card -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Login" Style="{StaticResource CardHeader}" />
                            <StackPanel>
                                <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding UserText}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Logout" Padding="10,2"
                                            Command="{Binding LogoutCommand}"
                                            ToolTip="Invalidates and deletes the stored session token, then restarts the login flow"
                                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <StackPanel Visibility="{Binding ShowLoginPanel, Converter={StaticResource BoolToVis}}"
                                            Margin="0,6,0,0">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Enter this code on the Twitch activation page:" />
                                    <TextBlock Text="{Binding DeviceCode}" HorizontalAlignment="Center"
                                               FontSize="22" FontWeight="Bold" Margin="0,2,0,4" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Open activation page" Padding="8,4" Margin="0,0,3,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding OpenLoginPageCommand}" />
                                        <Button Content="Copy code" Padding="8,4" Margin="3,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding CopyCodeCommand}" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Status card -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Status" Style="{StaticResource CardHeader}" />
                            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                                <Button Content="Reload" Padding="12,4" Margin="0,0,3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ReloadCommand}"
                                        ToolTip="Re-fetch the inventory and re-evaluate what to mine" />
                                <Button Content="Switch to channel" Padding="12,4" Margin="3,0,3,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding SwitchToSelectedCommand}"
                                        ToolTip="Switch to the selected channel in the list below" />
                                <Button Content="Mini mode" Padding="12,4" Margin="3,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="MiniMode_Click"
                                        ToolTip="Switch to the compact farming widget" />
                            </UniformGrid>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" VerticalAlignment="Top" />
                        </DockPanel>
                    </Border>

                    <!-- Campaign progress card -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Campaign progress" Style="{StaticResource CardHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap">
                                    <Run Text="Game: " /><Run Text="{Binding ProgressGameName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="   Campaign: " /><Run Text="{Binding ProgressCampaignName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Campaign progress:  " Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Right">
                                    <Run Text="{Binding CampaignPercentText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding CampaignRemainingText, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Height="14" Margin="0,3,0,0"
                                             Minimum="0" Maximum="1" Value="{Binding CampaignProgressValue, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Drop: " /><Run Text="{Binding DropRewardsText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Drop progress:  " Margin="0,2,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2,0,0" HorizontalAlignment="Right">
                                    <Run Text="{Binding DropPercentText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding DropRemainingText, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar Grid.Row="5" Grid.ColumnSpan="2" Height="14" Margin="0,3,0,0"
                                             Minimum="0" Maximum="1" Value="{Binding DropProgressValue, Mode=OneWay}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Websocket status card -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Websocket status" Style="{StaticResource CardHeader}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding WebsocketStatuses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WebsocketStatusViewModel}">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Output card -->
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Output" Style="{StaticResource CardHeader}" />
                            <TextBox x:Name="OutputBox"
                                     Text="{Binding OutputText, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     TextChanged="OutputBox_TextChanged" />
                        </DockPanel>
                    </Border>

                    <!-- Channels card -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Channels (double-click to switch)"
                                       Style="{StaticResource CardHeader}" />
                            <ContentControl DockPanel.Dock="Top" Template="{StaticResource SearchBar}">
                                <TextBox Text="{Binding ChannelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search channels by name or game" />
                            </ContentControl>
                            <DataGrid ItemsSource="{Binding ChannelsView}"
                                      SelectedItem="{Binding SelectedChannel}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      GridLinesVisibility="None" HeadersVisibility="Column"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      MouseDoubleClick="ChannelList_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Background" Value="#3322AA22" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="OFFLINE">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Channel" Width="2*" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="Status" Width="110" Binding="{Binding StatusText}" />
                                    <DataGridTextColumn Header="Game" Width="3*" Binding="{Binding GameName}" />
                                    <DataGridTextColumn Header="🎁" Width="50" Binding="{Binding DropsText}" />
                                    <DataGridTextColumn Header="Viewers" Width="110" Binding="{Binding ViewersText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ INVENTORY TAB ============================ -->
            <TabItem Header="Inventory">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Campaigns" Style="{StaticResource CardHeader}" Margin="0,0,16,0" />
                                <CheckBox Content="Upcoming" IsChecked="{Binding ShowUpcomingCampaigns}" />
                                <CheckBox Content="Expired" Margin="12,0,0,0" IsChecked="{Binding ShowExpiredCampaigns}" />
                                <CheckBox Content="Finished" Margin="12,0,16,0" IsChecked="{Binding ShowFinishedCampaigns}" />
                            </StackPanel>
                            <ContentControl Grid.Column="1" Template="{StaticResource SearchBar}"
                                            VerticalAlignment="Center">
                                <TextBox Text="{Binding CampaignSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search campaigns by game, campaign or drop reward name" />
                            </ContentControl>
                        </Grid>
                        <ListBox ItemsSource="{Binding CampaignsView}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DropsCampaign}">
                                    <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6"
                                            Background="#10808080" Margin="0,2" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Width="60" Height="80"
                                                   Source="{Binding BoxArt}"
                                                   Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding Game.Name, Mode=OneWay}" FontWeight="Bold" FontSize="14" />
                                                    <Run Text="  |  " Foreground="Gray" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                                    <TextBlock Text="   " />
                                                    <TextBlock Text="{Binding TimeText}" />
                                                    <TextBlock Text="   " />
                                                    <TextBlock Text="{Binding CountText}" />
                                                    <TextBlock Text="   " />
                                                    <TextBlock Text="{Binding LinkedText}" />
                                                    <Button Content="Link account" Margin="12,0,0,0" Padding="6,0"
                                                            Command="{Binding DataContext.OpenCampaignLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Linked}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding DropsList}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:TimedDrop}">
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="110" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <ProgressBar Grid.Column="1" Height="12" Margin="6,0"
                                                                             Minimum="0" Maximum="1"
                                                                             Value="{Binding Progress, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                                           Foreground="Green" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ============================ SETTINGS TAB ============================ -->
            <TabItem Header="Settings">
                <TabControl Margin="2" TabStripPlacement="Left">
                    <!-- ===================== GENERAL SUB-TAB ===================== -->
                    <TabItem Header="General">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="General" Style="{StaticResource CardHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mining order:  "
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding MiningModes}"
                                          SelectedItem="{Binding SelectedMiningMode}"
                                          DisplayMemberPath="Label" />

                                <!-- Custom scoring builder, shown only for the Custom mode -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8"
                                        Background="#10808080" BorderBrush="#30808080"
                                        BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                                                   Foreground="Gray" Margin="0,0,0,6"
                                                   Text="Each factor is normalized per reload and multiplied by its weight; the highest total score is mined first. Set a weight to 0 to ignore that factor." />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Priority list position  "
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200"
                                                IsSnapToTickEnabled="True" TickFrequency="5"
                                                Value="{Binding CustomWeightPriority}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CustomWeightPriority, StringFormat={}{0:0}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Campaign ends soonest  "
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200"
                                                IsSnapToTickEnabled="True" TickFrequency="5"
                                                Value="{Binding CustomWeightEndingSoon}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CustomWeightEndingSoon, StringFormat={}{0:0}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Low availability (hard to finish in time)  "
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="200"
                                                IsSnapToTickEnabled="True" TickFrequency="5"
                                                Value="{Binding CustomWeightLowAvailability}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CustomWeightLowAvailability, StringFormat={}{0:0}}" />
                                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                                  Content="Also mine games that are not on the priority list"
                                                  IsChecked="{Binding CustomIncludeNonPriority}" />
                                    </Grid>
                                </Border>

                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <CheckBox Content="Tray notifications" Margin="0,0,16,4"
                                              IsChecked="{Binding TrayNotificationsEnabled}" />
                                    <CheckBox Content="Check available drops per channel (slower reloads)" Margin="0,0,16,4"
                                              IsChecked="{Binding AvailableDropsCheckEnabled}" />
                                    <CheckBox Content="Mine badges and emotes" Margin="0,0,16,4"
                                              IsChecked="{Binding BadgesEmotesEnabled}" />
                                    <CheckBox Content="Self-heal (auto-restart after errors)" Margin="0,0,16,4"
                                              IsChecked="{Binding AutoRestartOnError}"
                                              ToolTip="When the mining core hits a fatal error, restart it automatically with increasing delays instead of staying stopped" />
                                </WrapPanel>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Connection quality:  "
                                           VerticalAlignment="Center" Margin="0,4,0,0" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" MinWidth="60"
                                              ItemsSource="{Binding ConnectionQualities}"
                                              SelectedItem="{Binding ConnectionQuality}"
                                              ToolTip="Multiplies request timeouts (1 = good connection, 6 = very poor). Takes effect after an app restart." />
                                    <TextBlock Grid.Column="1" Text="   Debug log:  "
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2" MinWidth="150"
                                              ItemsSource="{Binding LogVerbosities}"
                                              SelectedItem="{Binding SelectedLogVerbosity}"
                                              DisplayMemberPath="Label"
                                              ToolTip="Verbosity of logs/debug.log; applies immediately. The info and error logs are always written." />
                                    <TextBlock Grid.Column="3" Text="   Proxy (http://host:port):  "
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="4" HorizontalAlignment="Stretch"
                                             Text="{Binding ProxyText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="5" Content="Apply" Margin="6,0,0,0" Padding="10,2"
                                            Command="{Binding ApplyProxyCommand}" />
                                </Grid>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mini mode:  "
                                           VerticalAlignment="Center" Margin="0,8,0,0" />
                                <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                                    <ComboBox MinWidth="150" Margin="0,0,12,0"
                                              ItemsSource="{Binding MiniBarOptions}"
                                              SelectedItem="{Binding SelectedMiniBar}"
                                              DisplayMemberPath="Label"
                                              ToolTip="What the mini widget's progress bar shows" />
                                    <CheckBox Content="Remaining time" Margin="0,4,16,0"
                                              IsChecked="{Binding MiniShowRemaining}" />
                                    <CheckBox Content="Percent label" Margin="0,4,16,0"
                                              IsChecked="{Binding MiniShowPercent}" />
                                    <CheckBox Content="Always on top" Margin="0,4,0,0"
                                              IsChecked="{Binding MiniAlwaysOnTop}" />
                                </WrapPanel>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Watch method:  "
                                           VerticalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <ComboBox MinWidth="240"
                                              ItemsSource="{Binding WatchMethods}"
                                              SelectedItem="{Binding SelectedWatchMethod}"
                                              DisplayMemberPath="Label"
                                              ToolTip="How the minute-watched event is delivered. Switchable on the fly (applies from the next watch tick). If drop progress stops advancing, try the other method." />
                                    <TextBlock Text="  Switch if drop progress stops advancing."
                                               VerticalAlignment="Center" Foreground="Gray" />
                                </StackPanel>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Channel language:  "
                                           VerticalAlignment="Center" Margin="0,8,0,0" />
                                <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,8,0,0">
                                    <CheckBox Content="Prefer my language" VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsChecked="{Binding PreferOwnLanguage}"
                                              ToolTip="Prefer channels broadcasting in your language, then English, then any. Uses Twitch's stream-language filter, so it costs a few extra requests per game on reload." />
                                    <ComboBox MinWidth="190" VerticalAlignment="Center"
                                              ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding PreferOwnLanguage}" />
                                    <TextBlock Text="{Binding LanguageHint}" VerticalAlignment="Center"
                                               Foreground="Gray" TextWrapping="Wrap" />
                                </WrapPanel>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Start with Windows:  "
                                           VerticalAlignment="Center" Margin="0,8,0,0" />
                                <WrapPanel Grid.Row="7" Grid.Column="1" Margin="0,8,0,0">
                                    <CheckBox Content="Enabled" VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsChecked="{Binding AutostartEnabled}"
                                              ToolTip="Launch this instance when you log in to Windows. Each folder/instance has its own entry." />
                                    <ComboBox MinWidth="240" Margin="0,0,12,0"
                                              ItemsSource="{Binding AutostartMethods}"
                                              SelectedItem="{Binding SelectedAutostartMethod}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding AutostartEnabled}"
                                              ToolTip="Task Scheduler is more robust (supports a startup delay) and recommended on servers. Both methods are scoped per instance." />
                                    <CheckBox Content="Start minimized to tray" VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsChecked="{Binding AutostartTrayEnabled}"
                                              IsEnabled="{Binding AutostartEnabled}" />
                                    <TextBlock Text="Delay (s):  " VerticalAlignment="Center" />
                                    <TextBox Width="50" VerticalAlignment="Center"
                                             Text="{Binding AutostartDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding AutostartEnabled}"
                                             ToolTip="Startup delay after logon (Task Scheduler method only)." />
                                </WrapPanel>
                                <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                           Foreground="Gray" TextWrapping="Wrap"
                                           Text="Changes to game lists, the mining order and the channel language are picked up on the next reload (Reload button on the Main tab)." />
                            </Grid>
                        </DockPanel>
                    </Border>

                    </TabItem>

                    <!-- ===================== NOTIFICATIONS SUB-TAB ===================== -->
                    <TabItem Header="Notifications">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Notifications (Discord &amp; Telegram)"
                                       Style="{StaticResource CardHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Discord webhook URL:  "
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Discord: Channel settings - Integrations - Webhooks - New Webhook - Copy URL. Leave empty to disable Discord." />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Telegram bot token:  "
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Create a bot with @BotFather, paste its token. Leave empty to disable Telegram." />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="   Chat ID:  "
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Your chat/user ID (e.g. from @userinfobot). Message your bot once so it can reply to you." />

                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                    <TextBlock Text="Notify on (opt-in):  " VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <CheckBox Content="Drop claimed" Margin="0,0,16,0"
                                              IsChecked="{Binding NotifyDropClaimed}" />
                                    <CheckBox Content="Campaign completed" Margin="0,0,16,0"
                                              IsChecked="{Binding NotifyCampaignCompleted}" />
                                    <CheckBox Content="Mining status changes" Margin="0,0,16,0"
                                              IsChecked="{Binding NotifyMiningStatus}" />
                                    <CheckBox Content="Errors &amp; login" Margin="0,0,16,0"
                                              IsChecked="{Binding NotifyErrors}" />
                                </WrapPanel>

                                <Button Grid.Row="3" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Padding="12,3"
                                        Content="Save &amp; send test message"
                                        Command="{Binding SaveAndTestNotificationsCommand}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    </TabItem>

                    <!-- ===================== GAME LISTS SUB-TAB ===================== -->
                    <TabItem Header="Game lists">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Game lists" Style="{StaticResource CardHeader}" />
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pattern entry (glob, e.g. &quot;EA Sports FC *&quot;):  "
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" HorizontalAlignment="Stretch"
                                         Text="{Binding PatternText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Add to priority" Margin="6,0,0,0" Padding="10,2"
                                        Command="{Binding AddPatternToPriorityCommand}" />
                                <Button Grid.Column="3" Content="Add to exclusions" Margin="6,0,0,0" Padding="10,2"
                                        Command="{Binding AddPatternToExcludeCommand}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionHeader}"
                                           Text="Priority list (top = highest)" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionHeader}"
                                           Text="Available games" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource SectionHeader}"
                                           Text="Exclusion list" />

                                <ContentControl Grid.Row="1" Grid.Column="0" Template="{StaticResource SearchBar}">
                                    <TextBox Text="{Binding PrioritySearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </ContentControl>
                                <ContentControl Grid.Row="1" Grid.Column="2" Template="{StaticResource SearchBar}">
                                    <TextBox Text="{Binding AvailableGamesSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </ContentControl>
                                <ContentControl Grid.Row="1" Grid.Column="4" Template="{StaticResource SearchBar}">
                                    <TextBox Text="{Binding ExcludeSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </ContentControl>

                                <ListBox Grid.Row="2" Grid.Column="0"
                                         ItemsSource="{Binding PriorityView}"
                                         SelectedItem="{Binding SelectedPriorityEntry}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                    <Button Content="◀ Add" Padding="6,3" Margin="0,2" MinWidth="90"
                                            Command="{Binding AddToPriorityCommand}"
                                            ToolTip="Add the selected available game to the priority list" />
                                    <Button Content="Remove ▶" Padding="6,3" Margin="0,2" MinWidth="90"
                                            Command="{Binding RemoveFromPriorityCommand}" />
                                    <Button Content="▲ Up" Padding="6,3" Margin="0,12,0,2" MinWidth="90"
                                            Command="{Binding MovePriorityUpCommand}" />
                                    <Button Content="▼ Down" Padding="6,3" Margin="0,2" MinWidth="90"
                                            Command="{Binding MovePriorityDownCommand}" />
                                </StackPanel>
                                <ListBox Grid.Row="2" Grid.Column="2"
                                         ItemsSource="{Binding AvailableGamesView}"
                                         SelectedItem="{Binding SelectedAvailableGame}"
                                         DisplayMemberPath="DisplayText" />
                                <StackPanel Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                                    <Button Content="Exclude ▶" Padding="6,3" Margin="0,2" MinWidth="90"
                                            Command="{Binding AddToExcludeCommand}" />
                                    <Button Content="◀ Remove" Padding="6,3" Margin="0,2" MinWidth="90"
                                            Command="{Binding RemoveFromExcludeCommand}" />
                                </StackPanel>
                                <ListBox Grid.Row="2" Grid.Column="4"
                                         ItemsSource="{Binding ExcludeView}"
                                         SelectedItem="{Binding SelectedExcludeEntry}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
